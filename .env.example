# Garmin Dash — Environment Configuration
# Copy this file to .env and fill in your values

# General
DEBUG=true
DOCKER_PROFILE=dev
# Subpath the dashboard is served under behind a reverse proxy (e.g. "/supermarxx").
# All asset/nav/redirect paths are prefixed with this so the app works when
# mounted at a URL prefix instead of the domain root. Leave empty for domain root.
# ROOT_PATH=/supermarxx

# Garmin Connect credentials (required for 'gdash auth start')
# Garmin sends an MFA code to your email/phone during first login.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where OAuth tokens are cached (directory, gitignored)
GARMINTOKENS=data/garmin/tokens

# Ingestion scheduler
SYNC_INTERVAL_MINUTES=15
SYNC_DAYS_BACK=3

# Local day boundary for intraday views and reports (IANA name)
TIMEZONE=Europe/Amsterdam

# Signal Messenger (Phase 4 — provision the number first, see ROADMAP)
# SIGNAL_CLI_TOKEN=your_signal_cli_token_here
# SIGNAL_CLI_API_URL=http://localhost:8080
# SIGNAL_ENABLED=false
# SIGNAL_ACCOUNT=+31612345678
# SIGNAL_RECIPIENT=+31612345678
# SIGNAL_REPORT_TIME=07:30
# SIGNAL_COMMAND_POLL_MINUTES=5
# SIGNAL_TIMEOUT=60.0   # HTTP timeout for Signal API (signal-cli is slow; too
                        # low makes sends time out after delivery -> duplicates)

# Journal (Phase 5)
# SIGNAL_JOURNAL_TIME=20:30        # evening journal reminder
# SIGNAL_DIGEST_TIME=20:00         # weekly insights digest
# SIGNAL_DIGEST_DAY=sun            # mon..sun
# JOURNAL_PROMPT_FACTORS_PER_DAY=3 # questions per Signal reminder (rotates)
# DASHBOARD_URL=https://dash.example.com   # links the full journal form in Signal

# LLM (Phase 6 — private OpenAI-compatible endpoint; explicit opt-in)
# LLM_ENABLED=false
# LLM_BASE_URL=https://your-openai-compatible-endpoint.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=1024  # reasoning models need room for internal reasoning + reply
# LLM_TEMPERATURE=0.3
# LLM_CONTEXT_WINDOW_DAYS=7
# LLM_MORNING_COMMENTARY=true
