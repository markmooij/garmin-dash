# Build context hygiene: keep secrets, local data, and junk out of the image
.git
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Secrets — never ship .env or credentials into the image
.env
.env.*
!.env.example
!.env.prod.example

# Local data — health data, tokens, SQLite DB, logs
# (match at any depth so migrated deployment data under docker/ is excluded too)
data/
**/data/
logs/
**/logs/
!libs/signal_messenger/tests/

# Migrated deployment bundle / runtime state under docker/
docker/garmin-dash/
*.tar.gz

# Editor/OS noise
.DS_Store
*.swp
