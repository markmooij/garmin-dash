# Garmin Dash — Environment Configuration
# Copy this file to .env and fill in your values

# General
DEBUG=true
DOCKER_PROFILE=dev

# Garmin (set after running 'gdash auth setup')
# GARMINTOKENS=your_garmin_token_here

# Signal Messenger
# SIGNAL_CLI_TOKEN=your_signal_cli_token_here
# SIGNAL_CLI_API_URL=http://localhost:8080

# LLM (Phase 6)
# LLM_BASE_URL=https://your-openai-compatible-endpoint.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o
