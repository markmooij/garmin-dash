# Garmin Dash — Production environment (Raspberry Pi)
# Copy this file to .env next to docker-compose.prod.yml on the Pi:
#   scp docker/.env.prod.example pi@<pi-ip>:~/garmin-dash/.env
# Then fill in the values below. See DEPLOY.md for the full walkthrough.

# ── Host mapping ────────────────────────────────────────────────────────
# Port on the Pi that serves the dashboard (http://<pi-ip>:<port>)
GARMINDASH_PORT=8000
# Subpath the dashboard is served under behind a reverse proxy (e.g. "/supermarxx").
# All asset/nav/redirect paths are prefixed with this so the app works when
# mounted at a URL prefix instead of the domain root. Leave empty for domain root.
# ROOT_PATH=/supermarxx
# Image to pull (defaults to ghcr.io/markmooij/garmin-dash:latest — see
# docker-compose.prod.yml). Override to pin a version tag, e.g.:
# GARMINDASH_IMAGE=ghcr.io/markmooij/garmin-dash:v0.1.0
# GARMINDASH_IMAGE=ghcr.io/markmooij/garmin-dash:latest
# Container architecture. The default (linux/arm64) is the Pi; set this to
# linux/amd64 when running an amd64 build (e.g. a locally built image).
# GARMINDASH_PLATFORM=linux/arm64
# UID/GID the containers run as — must match your Pi user so the
# ./data and ./logs bind mounts are writable (pi user = 1000:1000)
# On ROOTLESS Docker both must be 0 — see docker-compose.rootless.yml.
PUID=1000
PGID=1000
# Container timezone (also used for log timestamps)
TZ=Europe/Amsterdam

# ── Garmin Connect ──────────────────────────────────────────────────────
# Credentials are only needed to (re)authenticate; after first auth the
# cached tokens in ./data/garmin/tokens are used (copy them from your
# dev machine with:  scp -r data/garmin/tokens pi@<pi-ip>:~/garmin-dash/data/garmin/
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Token cache directory — relative to /app inside the container, which is
# the mounted ./data volume. Same layout as on the dev machine.
GARMINTOKENS=data/garmin/tokens

# ── Ingestion scheduler ─────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
SYNC_DAYS_BACK=3

# ── Local day boundary (intraday views, reports) ────────────────────────
TIMEZONE=Europe/Amsterdam

# ── Signal Messenger (Phase 4 — leave disabled until provisioned) ───────
# SIGNAL_ENABLED=false
# SIGNAL_ACCOUNT=+31612345678
# SIGNAL_RECIPIENT=+31612345678
# SIGNAL_REPORT_TIME=07:30
# SIGNAL_COMMAND_POLL_MINUTES=5
# SIGNAL_TIMEOUT=60.0   # HTTP timeout for Signal API (signal-cli is slow; too
                        # low makes sends time out after delivery -> duplicates)
# SIGNAL_CLI_TOKEN=your_signal_cli_token_here
# Host port for the signal-cli REST API (8080 if free; change when taken)
# SIGNAL_API_PORT=8080
# Path to signal-cli *inside* bbernhard/signal-cli-rest-api. Only change this
# if you run an image that installs it elsewhere.
# SIGNAL_CLI_BIN=/usr/bin/signal-cli

# ── Raw API snapshots (debugging data; nothing reads it in normal use) ──
# Snapshots are unique on (endpoint, key), so a re-sync overwrites instead of
# appending. The scheduler prunes rows not refetched for MAX_DAYS each night.
# RAW_PAYLOADS_ENABLED=true
# RAW_PAYLOADS_MAX_DAYS=90   # 0 = keep everything

# ── Journal & insights (Phase 5) ──────────────────────────────────────
# SIGNAL_JOURNAL_TIME=23:00        # evening wrap-up (day overview + reflection + journal)
# SIGNAL_EVENING_SUMMARY=true      # prepend the numeric day overview
# SIGNAL_DIGEST_TIME=20:00         # weekly insights digest
# SIGNAL_DIGEST_DAY=sun            # mon..sun
# JOURNAL_PROMPT_FACTORS_PER_DAY=3 # questions per Signal reminder (rotates)
# INSIGHTS_MAX_DISPLAY=8           # max insight cards shown on /insights
# INSIGHTS_LLM_MAX_PER_LOAD=3      # fresh LLM interpretations per page load
# Public URL of this dashboard — links the full journal form from Signal.
# DASHBOARD_URL=http://raspberrypi.local:8081

# ── LLM (Phase 6 — private OpenAI-compatible endpoint; explicit opt-in) ───────
# LLM_ENABLED=false
# LLM_BASE_URL=https://your-openai-compatible-endpoint.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=1024  # reasoning models need room for internal reasoning + reply
# LLM_TEMPERATURE=0.3
# LLM_CONTEXT_WINDOW_DAYS=7
# LLM_MORNING_COMMENTARY=true
# LLM_EVENING_REFLECTION=true      # LLM terugblik op de dag in de avondsamenvatting
